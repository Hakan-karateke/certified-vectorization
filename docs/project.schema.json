{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sekilden-denkleme:project:2.3",
  "title": "Şekilden Denkleme proje şeması 2.3 (2.0/2.1/2.2 uyumlu)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_version",
    "config",
    "normalization",
    "boundaries",
    "reference_boundaries",
    "polynomial",
    "metrics",
    "candidates",
    "selected_id",
    "topology",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.0",
        "2.1",
        "2.2",
        "2.3",
        "2.4"
      ]
    },
    "application_version": {
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "normalization": {
      "type": "object"
    },
    "boundaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "reference_boundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/boundary"
      }
    },
    "polynomial": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/polynomial"
        }
      ]
    },
    "metrics": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "selected_id": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "$ref": "#/$defs/topology"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "embedded_input_base64": {
          "type": [
            "string",
            "null"
          ],
          "contentEncoding": "base64"
        },
        "normalized_png_base64": {
          "type": "string",
          "contentEncoding": "base64",
          "contentMediaType": "image/png"
        },
        "random_seed": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "interval": {
      "$ref": "#/$defs/point"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold",
        "padding",
        "tolerance",
        "degree",
        "max_fit_points",
        "family",
        "preference",
        "evaluation_spacing",
        "flatten_tolerance",
        "embed_input"
      ],
      "properties": {
        "threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 254
        },
        "padding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 499
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "degree": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2,
          "maximum": 12
        },
        "max_fit_points": {
          "type": "integer",
          "minimum": 200,
          "maximum": 20000
        },
        "family": {
          "enum": [
            "exact",
            "polygon",
            "auto",
            "circle",
            "ellipse",
            "bezier",
            "bspline",
            "adaptive",
            "fourier",
            "topology",
            "mixed",
            "minlink",
            "linearc"
          ]
        },
        "preference": {
          "enum": [
            "simple",
            "balanced",
            "accurate"
          ]
        },
        "evaluation_spacing": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        },
        "flatten_tolerance": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 1
        },
        "embed_input": {
          "type": "boolean"
        },
        "search_strategy": {
          "enum": [
            "deterministic",
            "annealing"
          ]
        },
        "certificate_mode": {
          "enum": [
            "off",
            "selected",
            "strict"
          ]
        },
        "search_budget": {
          "type": "integer",
          "minimum": 4,
          "maximum": 100
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "evaluation_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "working_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertices",
        "kind",
        "original_vertex_count"
      ],
      "properties": {
        "vertices": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "kind": {
          "enum": [
            "outer",
            "hole"
          ]
        },
        "original_vertex_count": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "params",
        "interval",
        "start",
        "end",
        "boundary_id",
        "component_id",
        "transform",
        "errors",
        "tolerances"
      ],
      "properties": {
        "kind": {
          "enum": [
            "line",
            "circle",
            "ellipse",
            "bezier",
            "bspline",
            "fourier"
          ]
        },
        "params": {
          "type": "object"
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "start": {
          "$ref": "#/$defs/point"
        },
        "end": {
          "$ref": "#/$defs/point"
        },
        "boundary_id": {
          "type": "integer",
          "minimum": 0
        },
        "component_id": {
          "type": "integer",
          "minimum": 0
        },
        "transform": {
          "const": "normalization.source_to_working"
        },
        "errors": {
          "type": "object"
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "line"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "a",
                  "b"
                ],
                "additionalProperties": false,
                "properties": {
                  "a": {
                    "$ref": "#/$defs/point"
                  },
                  "b": {
                    "$ref": "#/$defs/point"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "circle"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "center",
                      "radius",
                      "direction"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "center": {
                        "$ref": "#/$defs/point"
                      },
                      "radius": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "direction": {
                        "enum": [
                          -1,
                          1
                        ]
                      },
                      "full_turn": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "arc"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "arc": {
                        "type": "object",
                        "required": [
                          "a",
                          "b",
                          "bulge"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "a": {
                            "$ref": "#/$defs/point"
                          },
                          "b": {
                            "$ref": "#/$defs/point"
                          },
                          "bulge": {
                            "type": "number",
                            "exclusiveMinimum": -1,
                            "exclusiveMaximum": 1,
                            "not": {
                              "const": 0
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ellipse"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "center",
                      "radii",
                      "rotation",
                      "direction"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "center": {
                        "$ref": "#/$defs/point"
                      },
                      "radii": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "rotation": {
                        "type": "number"
                      },
                      "direction": {
                        "enum": [
                          -1,
                          1
                        ]
                      },
                      "full_turn": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "arc"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "arc": {
                        "type": "object",
                        "required": [
                          "controls",
                          "weight"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "controls": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/point"
                            },
                            "minItems": 3,
                            "maxItems": 3
                          },
                          "weight": {
                            "type": "number",
                            "exclusiveMinimum": 0,
                            "exclusiveMaximum": 1
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bezier"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "controls"
                ],
                "additionalProperties": false,
                "properties": {
                  "controls": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "$ref": "#/$defs/point"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "bspline"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "controls",
                  "knots",
                  "degree"
                ],
                "additionalProperties": false,
                "properties": {
                  "degree": {
                    "const": 3
                  },
                  "controls": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 10000,
                    "items": {
                      "$ref": "#/$defs/point"
                    }
                  },
                  "knots": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "fourier"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "center",
                  "cos",
                  "sin"
                ],
                "additionalProperties": false,
                "properties": {
                  "center": {
                    "$ref": "#/$defs/point"
                  },
                  "cos": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "$ref": "#/$defs/point"
                    }
                  },
                  "sin": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 64,
                    "items": {
                      "$ref": "#/$defs/point"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "pieces",
        "metrics",
        "complexity",
        "accepted",
        "reasons",
        "pareto"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "family": {
          "enum": [
            "exact",
            "polygon",
            "circle",
            "ellipse",
            "bezier",
            "bspline",
            "mixed",
            "hybrid",
            "adaptive",
            "fourier",
            "topology",
            "minlink",
            "linearc"
          ]
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piece"
          }
        },
        "metrics": {
          "type": "object"
        },
        "complexity": {
          "type": "object"
        },
        "accepted": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pareto": {
          "type": "boolean"
        }
      }
    },
    "polynomial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "degree",
        "terms",
        "algebraic_rms",
        "gradient_distance_rms",
        "sample_count",
        "condition_number",
        "diagnostics"
      ],
      "properties": {
        "degree": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "number"
              }
            ],
            "items": false
          }
        },
        "algebraic_rms": {
          "type": "number",
          "minimum": 0
        },
        "gradient_distance_rms": {
          "type": [
            "number",
            "null"
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "condition_number": {
          "type": [
            "number",
            "null"
          ]
        },
        "diagnostics": {
          "type": "object"
        }
      }
    },
    "topology": {
      "type": "object",
      "required": [
        "rings",
        "component_count",
        "hole_count",
        "contacts",
        "connectivity"
      ],
      "properties": {
        "connectivity": {
          "const": "foreground_4_neighbors"
        },
        "component_count": {
          "type": "integer",
          "minimum": 1
        },
        "hole_count": {
          "type": "integer",
          "minimum": 0
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "rings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "parent_id",
              "component_id",
              "closed"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "outer",
                  "hole"
                ]
              },
              "parent_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "component_id": {
                "type": "integer",
                "minimum": 0
              },
              "closed": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
