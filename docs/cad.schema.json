{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sekilden-denkleme:cad:1.0",
  "title": "Şekilden Denkleme CAD eşleme kaydı 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_version",
    "format",
    "cad_file",
    "cad_sha256",
    "cad_options",
    "coordinate_contract",
    "representation",
    "orientation_contract",
    "selected_model",
    "topology",
    "normalization",
    "source",
    "implicit_polynomial",
    "entity_mapping",
    "native_curves",
    "approximated_source_pieces",
    "reader",
    "transfer_validation",
    "physical_error_summary",
    "original_model_certificate_scope",
    "cad_complexity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "application_version": {
      "type": "string"
    },
    "format": {
      "enum": [
        "dxf",
        "step",
        "iges"
      ]
    },
    "cad_file": {
      "type": "string",
      "minLength": 1
    },
    "cad_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cad_options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "scale",
        "tolerance",
        "allow_approximation"
      ],
      "properties": {
        "unit": {
          "enum": [
            "mm",
            "cm",
            "m",
            "in"
          ]
        },
        "scale": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 1000
        },
        "tolerance": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 10
        },
        "allow_approximation": {
          "type": "boolean"
        }
      }
    },
    "coordinate_contract": {
      "type": "object",
      "required": [
        "plane",
        "axis",
        "mapping",
        "physical_calibration"
      ]
    },
    "representation": {
      "type": "string"
    },
    "orientation_contract": {
      "type": "string"
    },
    "selected_model": {
      "type": "object",
      "required": [
        "id",
        "family",
        "pieces",
        "equations",
        "complexity",
        "metrics"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "pieces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "params",
              "interval",
              "start",
              "end",
              "boundary_id",
              "component_id"
            ]
          }
        },
        "equations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "complexity": {
          "type": "object"
        },
        "metrics": {
          "type": "object"
        }
      }
    },
    "topology": {
      "type": "object"
    },
    "normalization": {
      "type": "object"
    },
    "source": {
      "type": "object"
    },
    "implicit_polynomial": {
      "type": [
        "object",
        "null"
      ]
    },
    "entity_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "piece",
          "boundary",
          "interval",
          "reversed"
        ]
      }
    },
    "native_curves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "params",
          "source_piece",
          "boundary_id",
          "interval",
          "reversed"
        ]
      }
    },
    "approximated_source_pieces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reader": {
      "type": "object",
      "required": [
        "reader",
        "reader_version",
        "max_join_gap"
      ]
    },
    "transfer_validation": {
      "type": "object",
      "required": [
        "method",
        "transfer_upper_estimate",
        "tolerance",
        "unit",
        "verified_numerical_certificate",
        "analytic_isotopy_proven_for_cad_file",
        "polygon_nesting_preserved"
      ],
      "properties": {
        "verified_numerical_certificate": {
          "const": false
        },
        "analytic_isotopy_proven_for_cad_file": {
          "const": false
        },
        "polygon_nesting_preserved": {
          "const": true
        },
        "transfer_upper_estimate": {
          "type": "number",
          "minimum": 0
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "mm",
            "cm",
            "m",
            "in"
          ]
        }
      }
    },
    "physical_error_summary": {
      "type": "object",
      "required": [
        "unit",
        "source_verified_upper_scaled",
        "cad_transfer_upper_estimate",
        "combined_pixel_boundary_upper_estimate",
        "combined_verified_numerical_certificate",
        "ideal_object_error_known"
      ],
      "properties": {
        "combined_verified_numerical_certificate": {
          "const": false
        },
        "ideal_object_error_known": {
          "const": false
        },
        "source_verified_upper_scaled": {
          "type": [
            "number",
            "null"
          ]
        },
        "combined_pixel_boundary_upper_estimate": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "original_model_certificate_scope": {
      "type": "string"
    },
    "cad_complexity": {
      "type": "object",
      "required": [
        "native_curve_count",
        "native_control_points",
        "polyline_vertices",
        "reader_edge_or_entity_count",
        "cad_file_bytes",
        "source_model_score_bits"
      ]
    }
  },
  "$comment": "Geometrik parametre, eşitlik ve sonlu sayı sözleşmeleri uygulama tarafından ayrıca denetlenir. CAD doğrulaması aralık sertifikası değildir."
}
